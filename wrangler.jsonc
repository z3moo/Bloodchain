{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bloodchain",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-05-07",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
